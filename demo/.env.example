# Copy to demo/.env (gitignored) and fill ONE provider. All free-tier.
# Backend is chosen by MAS_BACKEND: stub | groq | openrouter | gemini
MAS_BACKEND=stub

# Groq (OpenAI-compatible)  https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (OpenAI-compatible)  https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Gemini via OpenAI-compat endpoint  https://aistudio.google.com/apikey
GEMINI_API_KEY=
